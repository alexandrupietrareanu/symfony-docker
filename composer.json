{
    "name": "assetmanagement/backend",
    "description": "Asset management project backend",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.5",
        "api-platform/doctrine-orm": "^4.3",
        "api-platform/symfony": "^4.3",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "league/flysystem-azure-blob-storage": "^3.31",
        "league/flysystem-bundle": "^3.7",
        "martin-georgiev/postgresql-for-doctrine": "^4.6",
        "nelmio/cors-bundle": "^2.6",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpdocumentor/type-resolver": "^2.0",
        "phpstan/phpdoc-parser": "^2.3",
        "stof/doctrine-extensions-bundle": "^1.15",
        "symfony/asset": "~8.1.0",
        "symfony/doctrine-messenger": "~8.1.0",
        "symfony/dotenv": "~8.1.0",
        "symfony/expression-language": "~8.1.0",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "~8.1.0",
        "symfony/http-client": "~8.1.0",
        "symfony/messenger": "~8.1.0",
        "symfony/mime": "~8.1.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/object-mapper": "~8.1.0",
        "symfony/property-access": "~8.1.0",
        "symfony/property-info": "~8.1.0",
        "symfony/runtime": "~8.1.0",
        "symfony/security-bundle": "~8.1.0",
        "symfony/serializer": "~8.1.0",
        "symfony/twig-bundle": "~8.1.0",
        "symfony/uid": "~8.1.0",
        "symfony/validator": "~8.1.0",
        "symfony/yaml": "~8.1.0"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6",
        "ergebnis/composer-normalize": "^2.52",
        "friendsofphp/php-cs-fixer": "^3.95",
        "league/flysystem-memory": "^3.31",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.2",
        "symfony/browser-kit": "~8.1.0",
        "symfony/debug-bundle": "~8.1.0",
        "symfony/maker-bundle": "^1.67",
        "symfony/stopwatch": "~8.1.0",
        "symfony/web-profiler-bundle": "~8.1.0",
        "vincentlanglet/twig-cs-fixer": "^4.0",
        "zenstruck/foundry": "^2.10",
        "zenstruck/messenger-test": "^1.14"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "docker": true,
            "require": "8.1.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "cs-fix": "vendor/bin/php-cs-fixer fix --diff",
        "lint": [
            "composer audit",
            "composer normalize --dry-run",
            "bin/console lint:container",
            "bin/console lint:twig templates",
            "vendor/bin/twig-cs-fixer lint",
            "bin/console lint:yaml config src",
            "bin/console -e test doctrine:schema:validate --skip-sync"
        ],
        "phpstan": "bin/console -e dev cache:warmup --quiet ; APP_ENV=dev php -dmemory_limit=-1 vendor/bin/phpstan analyse",
        "phpunit": [
            "Composer\\Config::disableProcessTimeout",
            "APP_ENV=test php -d memory_limit=-1 bin/phpunit"
        ],
        "phpunit-coverage": "APP_ENV=test XDEBUG_MODE=coverage,debug php -dmemory_limit=-1 vendor/bin/phpunit --coverage-html=./build/coverage"
    }
}
